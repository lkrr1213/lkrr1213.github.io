---
import type { Post } from '../lib/content';
import { copy, path, type Lang } from '../lib/site';
interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
---
<article class="post-item">
  <time datetime={post.data.publishedAt}>{post.data.publishedAt}</time>
  <div><h3><a href={path(lang, 'blog', post.data.slug)}>{post.data.title}</a></h3><p>{post.data.summary}</p><ul class="tag-list" aria-label={lang === 'zh' ? '标签' : 'Tags'}>{post.data.tags.map((tag) => <li>{tag}</li>)}</ul></div>
  <a class="post-arrow" href={path(lang, 'blog', post.data.slug)} aria-label={`${copy[lang].readPost}：${post.data.title}`}>↗</a>
</article>
